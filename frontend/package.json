    "@radix-ui/react-slot": "^1.2.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.511.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
