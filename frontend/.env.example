# Public values from Supabase Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Used by Drizzle only on the server and by migration generation.
# Keep this value in frontend/.env.local or your hosting provider, never in Git.
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# Used for absolute links in local and hosted environments.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional server-side transactional email. Leave unset to disable Resend delivery.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Razorpay server-side payment integration. Keep the secret values private.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Used only by the protected reminder/outbox dispatcher invoked by Supabase Cron.
# Store the production value in the hosting provider and Supabase Vault.
JOB_RUNNER_SECRET=
