{
  "name": "schedula-healthcare",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "dev": "pnpm --filter frontend dev",
    "build": "pnpm --filter frontend build",
    "lint": "pnpm --filter frontend lint",
    "typecheck": "pnpm --filter frontend typecheck",
    "test": "pnpm --filter frontend test",
    "test:integration": "pnpm --filter frontend test:integration",
    "test:e2e": "pnpm --filter frontend test:e2e",
    "test:quality": "pnpm --filter frontend test:quality",
    "release:check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "pnpm --filter frontend db:generate",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop"
  },
  "devDependencies": {
    "supabase": "^2.122.0"
  }
}
